{
  "name": "sub2api-gateway",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-10-25",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub2api-db",
      "database_id": "sub2api-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "sub2api-config-kv"
    }
  ],
  "vars": {
    "ERROR_RATE_THRESHOLD": "0.5",
    "ERROR_COUNT_THRESHOLD": "5",
    "WINDOW_SECONDS": "300",
    "MAX_SAME_ACCOUNT_RETRIES": "3"
  }
}
