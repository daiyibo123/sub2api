{
  "name": "sub2api-gateway",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-10-25",
  "pages_build_output_dir": "frontend",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub2api-db",
      "database_id": "48281dab-c44b-496c-b1da-5cb409a6d6e2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "b8674b89affa40889d3d869951de5eb4"
    }
  ],
  "vars": {
    "ERROR_RATE_THRESHOLD": "0.5",
    "ERROR_COUNT_THRESHOLD": "5",
    "WINDOW_SECONDS": "300",
    "MAX_SAME_ACCOUNT_RETRIES": "3"
  }
}
