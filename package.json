{
  "name": "sub2api-cloudflare-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "build:functions": "esbuild functions/_worker.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=functions/_worker.js && esbuild functions/_worker.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=frontend/_worker.js",
    "build": "npm run build:functions",
    "typecheck": "tsc --noEmit -p functions/tsconfig.json",
    "test:ui": "node tests/ui.test.mjs",
    "test:api": "python tests/api.test.py",
    "test:gateway": "python tests/gateway.test.py",
    "test:features": "python tests/features.test.py",
    "test": "npm run typecheck && npm run build && npm run test:source && npm run test:pricing && npm run test:ui && npm run test:resilience",
    "test:pricing": "node tests/pricing.test.mjs",
    "test:resilience": "node tests/resilience.test.mjs",
    "dev": "npm run build:functions && wrangler pages dev frontend --compatibility-flag=nodejs_compat",
    "deploy": "npm run build:functions && wrangler pages deploy frontend --project-name sub2api-gateway",
    "test:source": "node tests/source.test.mjs",
    "test:migration": "python tests/migration.test.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250829.0",
    "esbuild": "^0.25.9",
    "jsdom": "^24.1.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.33.0"
  }
}
